# ISOs y archivos pesados
*.iso
*.img

# Logs de wget y build
wget-log*
*.log
build.log

# Directorios generados por live-build
cache/
chroot/
binary/
.build/

# Archivos de estado del build
binary.modified_timestamps
chroot.files
chroot.packages.*
RisingOS-amd64.*
/includes.chroot/
*.buildinfo
*.changes
*.bak*
__pycache__/

# Staging de dpkg-buildpackage (se regenera en cada build, no es fuente)
**/debian/.debhelper/
**/debian/files
**/debian/*.substvars
**/debian/*/DEBIAN/
**/debian/*/usr/
**/debian/*.dch

# Artefactos .deb sueltos en la raíz del build (los .deb versionados
# a propósito viven en config/packages.chroot/, no acá)
/*.deb

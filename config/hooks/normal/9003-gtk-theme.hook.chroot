#!/bin/bash
# =============================================================================
# RisingOS — Hook: Activar tema GTK RisingOS-Dark por defecto
# El tema en si (gtk-3.0/gtk.css, gtk-4.0, assets) ya viene completo desde
# includes.chroot/usr/share/themes/RisingOS-Dark/ - este hook solo setea
# los settings.ini del skel/root/usuario live para que apunten a el.
# =============================================================================
set -euo pipefail

echo "[gtk-theme] === Activando tema GTK RisingOS-Dark ==="

SKEL_GTK3="/etc/skel/.config/gtk-3.0"
SKEL_GTK4="/etc/skel/.config/gtk-4.0"

mkdir -p "${SKEL_GTK3}" "${SKEL_GTK4}"

# ── settings.ini para GTK3 del skel ──────────────────────────────────────────
cat > "${SKEL_GTK3}/settings.ini" << 'EOF'
[Settings]
gtk-theme-name          = RisingOS-Dark
gtk-icon-theme-name     = RisingOS-orange-dark
gtk-cursor-theme-name   = Adwaita
gtk-cursor-theme-size   = 24
gtk-font-name           = Inter 10
gtk-button-images       = 0
gtk-menu-images         = 0
gtk-toolbar-style       = GTK_TOOLBAR_BOTH_HORIZ
gtk-xft-antialias       = 1
gtk-xft-hinting         = 1
gtk-xft-hintstyle       = hintslight
gtk-xft-rgba            = rgb
EOF

# ── settings.ini para GTK4 del skel ──────────────────────────────────────────
cat > "${SKEL_GTK4}/settings.ini" << 'EOF'
[Settings]
gtk-theme-name          = RisingOS-Dark
gtk-icon-theme-name     = RisingOS-orange-dark
gtk-cursor-theme-name   = Adwaita
gtk-cursor-theme-size   = 24
gtk-font-name           = Inter 10
gtk-application-prefer-dark-theme = 1
EOF

# ── Copiar settings.ini también para root (por si Calamares corre como root) ──
mkdir -p /root/.config/gtk-3.0 /root/.config/gtk-4.0
cp "${SKEL_GTK3}/settings.ini" /root/.config/gtk-3.0/
cp "${SKEL_GTK4}/settings.ini" /root/.config/gtk-4.0/

# ── Copiar settings.ini al directorio de usuario live ────────────────────────
LIVE_HOME="/home/usuario"
if [ -d "${LIVE_HOME}" ]; then
    mkdir -p "${LIVE_HOME}/.config/gtk-3.0" "${LIVE_HOME}/.config/gtk-4.0"
    cp "${SKEL_GTK3}/settings.ini" "${LIVE_HOME}/.config/gtk-3.0/"
    cp "${SKEL_GTK4}/settings.ini" "${LIVE_HOME}/.config/gtk-4.0/"
fi

echo "[gtk-theme] === Tema GTK RisingOS-Dark activado ==="

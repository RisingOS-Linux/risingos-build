#!/bin/bash
# =============================================================================
# RisingOS — Hook 9900: Configuración completa de Calamares
# Resuelve: items 1 (sidebar), 2 (slideshow), 3 (botones), 4 (GRUB),
#           5 (ícono instalar), 6 (calamares-install-debian.desktop), 7 (sudoers)
# Se ejecuta dentro del chroot de live-build (sistema live, NO el instalado)
# =============================================================================
set -euo pipefail

BRANDING_DIR="/etc/calamares/branding/risingos"
MODULES_DIR="/etc/calamares/modules"
LOGO_SRC="/usr/share/rising-welcome/assets/icons/logo-256.png"
LOGO_DST="${BRANDING_DIR}/risingos-logo.png"
SKEL_DESKTOP="/etc/skel/Desktop"
SKEL_AUTOSTART="/etc/skel/.config/autostart"

echo "[9900] === Iniciando configuración de Calamares para RisingOS ==="

# ── 0. Asegurar que Calamares esté instalado ──────────────────────────────────
if ! command -v calamares &>/dev/null; then
    echo "[9900] WARN: calamares no encontrado, saltando configuración"
    exit 0
fi

# ── 1. Crear directorio de branding ──────────────────────────────────────────
mkdir -p "${BRANDING_DIR}"
mkdir -p "${MODULES_DIR}"

# ── 2. Copiar logo al branding (item 7) ──────────────────────────────────────
if [ -f "${LOGO_SRC}" ]; then
    cp "${LOGO_SRC}" "${LOGO_DST}"
    echo "[9900] Logo copiado: ${LOGO_DST}"
else
    echo "[9900] WARN: Logo no encontrado en ${LOGO_SRC}"
    # Crear placeholder SVG como fallback
    cat > "${LOGO_DST%.png}.svg" << 'SVGEOF'
<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">
  <rect width="256" height="256" rx="32" fill="#0c1221"/>
  <text x="128" y="148" font-family="sans-serif" font-size="80" font-weight="bold"
        text-anchor="middle" fill="#ff6a3d">R</text>
</svg>
SVGEOF
fi

# ── 3. Escribir branding.desc (items 1, 3 — sidebar y botones) ───────────────
#cat > "${BRANDING_DIR}/branding.desc" << 'EOF'
#---
#componentName: risingos
#
#shortProductName: RisingOS
#productName:      RisingOS Linux
#shortVersion:     "1.0"
#version:          "1.0 (Trixie)"
#shortVersionedName: RisingOS 1.0
#versionedName:    RisingOS 1.0 (Trixie)
#
#supportUrl:       ""
#releaseNotesUrl:  ""
#donateUrl:        ""
#knownIssuesUrl:   ""
#
#organizationName: Rising Arrow
#organizationUrl:  https://rising-arrow.com
#
#logoImage: risingos-logo.png
#
#slideshowAPI: 2
#slideshow:    show.qml
#
#style:
#  sidebarBackground:       "#0c1221"
#  sidebarText:             "#ffffff"
#  sidebarTextSelect:       "#ff6a3d"
#  sidebarBackgroundSelect: "#1a2340"
#
#windowExpanding:  normal
#windowSize:       "800px,520px"
#windowPlacement:  center
#EOF
echo "[9900] branding.desc escrito"

# ── 4. Escribir show.qml (item 2 — slideshow funcional) ──────────────────────
cat > "${BRANDING_DIR}/show.qml" << 'QMLEOF'
/* RisingOS — Calamares Slideshow
 * slideshowAPI: 2  ← DEBE coincidir con branding.desc
 *
 * Fix item 2: con API 2 Calamares llama a onActivate() / onLeave()
 * y el slideshow se controla desde QML con un Timer.
 * La pantalla en blanco ocurría porque el QML usaba API 1 sin declararlo.
 *
 * Las 5 slides usan imagen (estilo isométrico 3D consistente, paleta
 * RisingOS) en lugar de íconos de texto/emoji, para mantener jerarquía
 * visual pareja entre todas las diapositivas.
 */

import QtQuick 2.15
import QtQuick.Controls 2.15

Item {
    id: root
    width:  800
    height: 520

    // ── Calamares Slideshow API 2 ──────────────────────────────
    // Estas funciones son llamadas por Calamares al mostrar/ocultar el slideshow
    function onActivate()   { timer.start() }
    function onLeave()      { timer.stop()  }

    // ── Slides ──────────────────────────────────────────────────
    property int currentSlide: 0
    property var slides: [
        {
            title:  "Bienvenido a RisingOS",
            body:   "Sistema Operativo GNU/Linux, desarrollado para potenciar\ntu hardware, con el poder y la estabilidad de Debian.",
            image:  "rising-arrow-hero.png"
        },
        {
            title:  "Estable por diseño",
            body:   "Basado en Debian 13 Trixie y XFCE 4.20:\nliviano, confiable, sin sorpresas.",
            image:  "escritorio.png"
        },
        {
            title:  "Arrancá con todo resuelto",
            body:   "Rising Welcome te guía desde el primer arranque:\nconfigurá tu sistema, instalá apps y conocé las novedades.",
            image:  "rising-welcome-robot.png"
        },
        {
            title:  "IA local, sin depender de internet",
            body:   "Ollama, Qwen y Open WebUI instalados con un clic.\nCorre en tu propia máquina.",
            image:  "rising-ia-robot.png"
        },
        {
            title:  "Con los pies en Latinoamérica,\ny la mirada en el mundo",
            body:   "Soporte en español, repositorio propio, y decisiones\npensadas en los usuarios de la región. Pero como esto\nes Linux, sencillamente es mundial.",
            image:  "rising-globe-hero.png"
        }
    ]

    // ── Timer de avance automático ─────────────────────────────
    Timer {
        id: timer
        interval: 5000
        repeat:   true
        onTriggered: {
            currentSlide = (currentSlide + 1) % slides.length
        }
    }

    // ── Fondo ───────────────────────────────────────────────────
    Rectangle {
        anchors.fill: parent
        color: "#0c1221"
    }

    // ── Imagen de fondo del slide activo ───────────────────────
    Image {
        id: slideImage
        anchors.fill: parent
        source:    slides[currentSlide].image
        fillMode:  Image.PreserveAspectCrop
        clip:      true

        Behavior on opacity { NumberAnimation { duration: 400 } }
    }

    // ── Gradiente oscuro inferior, para legibilidad del texto ──
    Rectangle {
        anchors {
            left:   parent.left
            right:  parent.right
            bottom: parent.bottom
        }
        height: parent.height * 0.48

        gradient: Gradient {
            GradientStop { position: 0.0; color: "#000c1221" }
            GradientStop { position: 0.55; color: "#cc0c1221" }
            GradientStop { position: 1.0;  color: "#0c1221" }
        }
    }

    // ── Texto superpuesto, anclado abajo ───────────────────────
    Column {
        anchors {
            left:         parent.left
            right:        parent.right
            bottom:       parent.bottom
            bottomMargin: 46
            leftMargin:   parent.width * 0.06
            rightMargin:  parent.width * 0.06
        }
        spacing: 10

        Text {
            text:           slides[currentSlide].title
            color:          "#ff6a3d"
            font.pixelSize: 25
            font.bold:      true
            anchors.horizontalCenter: parent.horizontalCenter
            horizontalAlignment: Text.AlignHCenter
            width:          parent.width
            wrapMode:       Text.WordWrap

            Behavior on opacity { NumberAnimation { duration: 400 } }
        }

        Text {
            text:           slides[currentSlide].body
            color:          "#e8eaf0"
            font.pixelSize: 14
            wrapMode:       Text.WordWrap
            anchors.horizontalCenter: parent.horizontalCenter
            horizontalAlignment: Text.AlignHCenter
            width:          parent.width
        }
    }

    // ── Indicadores de posición ────────────────────────────────
    Row {
        anchors {
            horizontalCenter: parent.horizontalCenter
            bottom:           parent.bottom
            bottomMargin:     16
        }
        spacing: 10

        Repeater {
            model: slides.length
            Rectangle {
                width:  index === currentSlide ? 22 : 8
                height: 8
                radius: 4
                color:  index === currentSlide ? "#ff6a3d" : "#1a2340"

                Behavior on width { NumberAnimation { duration: 300 } }
                Behavior on color { ColorAnimation  { duration: 300 } }
            }
        }
    }
}
QMLEOF
echo "[9900] show.qml escrito"

# ── 5. Escribir settings.conf (item 7 — con shellprocess-grub en exec) ────────
cat > "/etc/calamares/settings.conf" << 'EOF'
modules-search: [ local, /usr/lib/calamares/modules, /usr/lib/x86_64-linux-gnu/calamares/modules ]
instances:
- id:       shellprocess-grub
  module:   shellprocess
  config:   shellprocess-grub.conf
- id:       shellprocess-removecalamares
  module:   shellprocess
  config:   shellprocess-removecalamares.conf
sequence:
- show:
  - welcome
  - locale
  - keyboard
  - partition
  - users
  - summary
- exec:
  - partition
  - mount
  - unpackfs
  - machineid
  - fstab
  - locale
  - keyboard
  - localecfg
  - users
  - displaymanager
  - networkcfg
  - hwclock
  - services-systemd
  - grubcfg
  - bootloader
  - shellprocess@shellprocess-grub
  - shellprocess@shellprocess-removecalamares
  - removeuser
  - umount
- show:
  - finished
branding: risingos
prompt-install: false
dont-chroot: false
disable-cancel-during-exec: true
EOF
echo "[9900] settings.conf escrito (con shellprocess-grub)"

# ── 6. Módulo shellprocess-grub (item 4) ──────────────────────────────────────
cat > "${MODULES_DIR}/shellprocess-grub.conf" << 'EOF'
---
# Copia el tema GRUB de RisingOS al sistema instalado
dontChroot: false
script:
  - "echo '--- shellprocess-grub start ---' > /var/log/risingos-grub-theme.log"
  - "mkdir -p /boot/grub/themes/risingos 2>>/var/log/risingos-grub-theme.log"
  - "ls -la /usr/share/grub/themes/risingos/ >> /var/log/risingos-grub-theme.log 2>&1"
  - "-cp -rv /usr/share/grub/themes/risingos/. /boot/grub/themes/risingos/ >> /var/log/risingos-grub-theme.log 2>&1"
  - "ls -la /boot/grub/themes/risingos/ >> /var/log/risingos-grub-theme.log 2>&1"
  - "grep -q '^GRUB_THEME=' /etc/default/grub && sed -i 's|^GRUB_THEME=.*|GRUB_THEME=\"/boot/grub/themes/risingos/theme.txt\"|' /etc/default/grub || echo 'GRUB_THEME=\"/boot/grub/themes/risingos/theme.txt\"' >> /etc/default/grub"
  - "cat /etc/default/grub | grep -i theme >> /var/log/risingos-grub-theme.log"
  - "mkdir -p /etc/grub.d/disabled"
  - "-mv /etc/grub.d/05_debian_theme /etc/grub.d/disabled/05_debian_theme.bak 2>>/var/log/risingos-grub-theme.log"
  - "echo '05_debian_theme movido a disabled (o ya no existía)' >> /var/log/risingos-grub-theme.log"
  - "grep -q '^GRUB_DISABLE_OS_PROBER=' /etc/default/grub && sed -i 's|^GRUB_DISABLE_OS_PROBER=.*|GRUB_DISABLE_OS_PROBER=false|' /etc/default/grub || echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub"
  - "cat /etc/default/grub | grep -i os_prober >> /var/log/risingos-grub-theme.log"
  - "update-grub >> /var/log/risingos-grub-theme.log 2>&1"
  - "echo '--- shellprocess-grub end ---' >> /var/log/risingos-grub-theme.log"
EOF
echo "[9900] shellprocess-grub.conf escrito"
# ── 6b. Módulo shellprocess-removecalamares (purga calamares post-instalación) ─
cat > "${MODULES_DIR}/shellprocess-removecalamares.conf" << 'EOF'
---
# Purga el paquete calamares y dependencias huerfanas del sistema instalado.
# Calamares esta pensado para correr desde el live, no debe quedar disponible
# ni ejecutable en el sistema ya instalado (riesgo de uso accidental).
dontChroot: false
script:
  - "apt-get purge -y calamares >> /var/log/risingos-remove-calamares.log 2>&1"
  - "apt-get autoremove -y --purge >> /var/log/risingos-remove-calamares.log 2>&1"
EOF
echo "[9900] shellprocess-removecalamares.conf escrito"

# ── 7. /etc/sudoers.d/calamares (item 7) ─────────────────────────────────────
mkdir -p /etc/sudoers.d
cat > /etc/sudoers.d/calamares << 'EOF'
# Permite al usuario live ejecutar Calamares sin contraseña
usuario ALL=(ALL) NOPASSWD: /usr/bin/calamares, /usr/local/bin/risingos-install
EOF
chmod 440 /etc/sudoers.d/calamares
echo "[9900] sudoers.d/calamares escrito"

# ── 8. /usr/local/bin/risingos-install (item 7) ───────────────────────────────
cat > /usr/local/bin/risingos-install << 'EOF'
#!/bin/bash
# Lanzador de Calamares con privilegios para RisingOS
exec sudo /usr/bin/calamares "$@"
EOF
chmod +x /usr/local/bin/risingos-install
echo "[9900] risingos-install escrito"

# ── 9. Limpiar Desktop del skel (items 5 y 6) ────────────────────────────────
echo "[9900] Limpiando Desktop del skel..."

# Eliminar calamares-install-debian.desktop (item 6 — 0 bytes, lo crea calamares-settings-debian)
for f in \
    "${SKEL_DESKTOP}/calamares-install-debian.desktop" \
    "${SKEL_DESKTOP}/install-debian.desktop" \
    "${SKEL_DESKTOP}/calamares.desktop"; do
    if [ -f "$f" ]; then
        rm -f "$f"
        echo "[9900] Eliminado: $f"
    fi
done

# Asegurar que solo existe el .desktop de RisingOS en el Desktop
# (el de la fase anterior lo pone el includes.chroot)
echo "[9900] Desktop del skel limpio"

# ── 10. Autostart: solo rising-welcome (item 5) ───────────────────────────────
# Verificar que rising-welcome.desktop tiene la guarda de sesión live
RWAUTO="${SKEL_AUTOSTART}/rising-welcome.desktop"
if [ -f "${RWAUTO}" ]; then
    # Si ya tiene OnlyShowIn o X-GNOME-Autostart-enabled, no tocar
    if ! grep -q "^X-RisingOS-LiveGuard=" "${RWAUTO}"; then
        echo "" >> "${RWAUTO}"
        echo "# Solo ejecutar en sesión instalada (no en live)" >> "${RWAUTO}"
        echo "X-RisingOS-LiveGuard=true" >> "${RWAUTO}"
    fi
    echo "[9900] rising-welcome.desktop verificado"
fi

# ── 11. Copiar tema GRUB al sistema live (para que shellprocess lo encuentre) ──
GRUB_THEME_SRC="/usr/share/grub/themes/risingos"
mkdir -p "${GRUB_THEME_SRC}"
cp -f /usr/share/grub/themes/risingos/*.pf2 "${GRUB_THEME_SRC}/" 2>/dev/null || true

# theme.txt básico si no existe aún
if [ ! -f "${GRUB_THEME_SRC}/theme.txt" ]; then
    cat > "${GRUB_THEME_SRC}/theme.txt" << 'GRUBEOF'
title-text:   ""
desktop-color: "#0c1221"

+ boot_menu {
    left:   15%
    top:    28%
    width:  70%
    height: 45%
    item_color:            "#e8eaf0"
    item_font:             "DejaVu Sans Regular 14"
    item_height:           36
    item_padding:          14
    item_spacing:          4
    selected_item_color:   "#ffffff"
    selected_item_font:    "DejaVu Sans Bold 14"
    + highlight {
        style: box
        color: "#ff6a3d"
        left:  0
        width: 100%
        height: 36
    }
}

+ label {
    top:    85%
    left:   0
    width:  100%
    height: 6%
    align:  center
    color:  "#6b7694"
    font:   "DejaVu Sans Regular 11"
    text:   "Use ↑↓ para navegar  •  Enter para iniciar"
}
GRUBEOF
    echo "[9900] theme.txt de GRUB creado en ${GRUB_THEME_SRC}"
fi
rm -f /home/user/Desktop/calamares-install-debian.desktop
rm -f /home/user/Desktop/install-debian.desktop
# Crear .desktop de instalar RisingOS en el Desktop del usuario live
mkdir -p /home/usuario/Desktop
cat > /home/usuario/Desktop/instalar-risingos.desktop << 'DEOF'
[Desktop Entry]
Type=Application
Version=1.0
Name=Instalar RisingOS
GenericName=Instalador de RisingOS
Comment=Instalá RisingOS en tu disco
Exec=/usr/local/bin/risingos-install
Icon=/etc/calamares/branding/risingos/risingos-logo.png
Terminal=false
Categories=Qt;System;
StartupWMClass=calamares
StartupNotify=true
DEOF
chmod +x /home/usuario/Desktop/instalar-risingos.desktop
chown -R usuario:usuario /home/usuario/Desktop
echo "[9900] === Configuración de Calamares completada ==="

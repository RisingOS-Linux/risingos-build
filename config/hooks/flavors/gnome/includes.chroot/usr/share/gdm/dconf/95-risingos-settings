# RisingOS — overrides de branding para la pantalla de login (GDM)
# Se compila junto con 00-upstream-settings y 90-debian-settings via
# /usr/share/gdm/generate-config (dconf compile), que corre automaticamente
# como ExecStartPre/ExecReload del servicio gdm3.service. El prefijo 95
# (mayor que 90-debian-settings) asegura que estos valores ganen sin
# necesidad de tocar el archivo original de Debian.

[org/gnome/login-screen]
logo='/usr/share/risingos/branding/risingos-imagotipo-login.png'

[org/gnome/desktop/interface]
gtk-theme='Adwaita'
color-scheme='prefer-dark'
accent-color='orange'

# NOTA: el fondo de esta pantalla (blur/wallpaper) NO se controla via
# gsettings/dconf. GNOME Shell define el fondo del login/bloqueo via CSS
# compilado dentro de gnome-shell-theme.gresource (selector #lockDialogGroup),
# ignorando org/gnome/desktop/background por completo en este contexto.
# Confirmado empiricamente: se probo picture-uri + picture-uri-dark, ambos
# compilaron y se leyeron bien via 'strings'/gsettings, sin efecto visual.
# Requeriria desempaquetar y parchear el .gresource (riesgo alto, afecta
# el tema visual completo del shell) - descartado por decision de Fran,
# 11/08/2026. Se acepta como limitacion conocida.

msgid "Actualizaciones de RisingOS"
msgstr "RisingOS Updates"

msgid "Hay actualizaciones disponibles para tu sistema."
msgstr "There are updates available for your system."

msgid "↓  Actualiza tu sistema"
msgstr "↓  Update your system"

msgid "Actualizando..."
msgstr "Updating..."

msgid "[flatpak no está instalado — se omite ese paso]\n"
msgstr "[flatpak is not installed — skipping that step]\n"

#, python-brace-format
msgid "Error: {error}\n"
msgstr "Error: {error}\n"

msgid "Tu sistema se ha actualizado correctamente"
msgstr "Your system has been updated successfully"

msgid "Tu sistema está al día."
msgstr "Your system is up to date."

msgid "El sistema no se pudo actualizar"
msgstr "The system could not be updated"

msgid "Revisá tu conexión a internet e intentá de nuevo."
msgstr "Check your internet connection and try again."

msgid "Actualizaciones disponibles"
msgstr "Updates available"

#, python-brace-format
msgid "Hay {count} paquete(s) para actualizar en tu sistema."
msgstr "There are {count} package(s) to update on your system."

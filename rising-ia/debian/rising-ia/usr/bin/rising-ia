#!/usr/bin/env python3
# =============================================================================
# Rising IA — Instalador de stack de IA local para RisingOS
# Versión corregida:
#   item 8:  Fix Docker pull colgado (timeout, retry, imagen alternativa)
#   item 9:  Detección de sesión live (/proc/cmdline boot=live)
#   item 10: Crea .desktop de Open WebUI al finalizar
# =============================================================================

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")

from gi.repository import Gtk, Adw, GLib, Gio, Pango
import subprocess
import threading
import os
import sys
import shutil

# ── Constantes ─────────────────────────────────────────────────────────────────
APP_ID          = "online.rising_arrow.rising_ia"
VERSION         = "1.0.0"
OLLAMA_URL      = "https://ollama.ai/install.sh"
OPENWEBUI_IMAGE = "ghcr.io/open-webui/open-webui:main"
# Imagen alternativa si la principal falla (más liviana, sin builds extras)
OPENWEBUI_IMAGE_FALLBACK = "ghcr.io/open-webui/open-webui:ollama"
WEBUI_PORT      = 3000
DESKTOP_FILE    = os.path.expanduser("~/.local/share/applications/open-webui.desktop")

CSS = """
window {
    background-color: #0c1221;
}
.title-label {
    color: #ff6a3d;
    font-size: 22px;
    font-weight: bold;
}
.subtitle-label {
    color: #9aa5c4;
    font-size: 13px;
}
.step-label {
    color: #e8eaf0;
    font-size: 14px;
}
.accent-button {
    background-color: #ff6a3d;
    color: #ffffff;
    border-radius: 8px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
    border: none;
}
.accent-button:disabled {
    background-color: #2a3550;
    color: #6b7694;
}
.live-warning {
    background-color: #2a1a0a;
    border: 1px solid #ff6a3d;
    border-radius: 8px;
    padding: 12px;
    color: #ffb380;
    font-size: 13px;
}
.log-view {
    background-color: #060d1a;
    color: #7ecb9e;
    font-family: monospace;
    font-size: 12px;
    border-radius: 6px;
    padding: 8px;
}
progressbar trough {
    background-color: #1a2340;
    border-radius: 4px;
}
progressbar progress {
    background-color: #ff6a3d;
    border-radius: 4px;
}
"""


def is_live_session() -> bool:
    """Detecta si se está ejecutando desde la sesión live (item 9)."""
    try:
        with open("/proc/cmdline", "r") as f:
            cmdline = f.read()
        return "boot=live" in cmdline or "live-media" in cmdline
    except Exception:
        return False


def create_openwebui_desktop():
    """Crea el .desktop de Open WebUI en aplicaciones del usuario (item 10)."""
    os.makedirs(os.path.dirname(DESKTOP_FILE), exist_ok=True)
    content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name=Open WebUI
Comment=Interfaz web para modelos de IA locales
Exec=xdg-open http://localhost:{WEBUI_PORT}
Icon=web-browser
Terminal=false
Categories=Science;Education;Utility;
Keywords=IA;AI;Ollama;LLM;
StartupNotify=false
"""
    with open(DESKTOP_FILE, "w") as f:
        f.write(content)
    os.chmod(DESKTOP_FILE, 0o644)

    # Actualizar base de datos de aplicaciones
    try:
        subprocess.run(
            ["update-desktop-database", os.path.dirname(DESKTOP_FILE)],
            capture_output=True, timeout=10
        )
    except Exception:
        pass


# ── Clase principal ────────────────────────────────────────────────────────────
class RisingIAWindow(Adw.ApplicationWindow):

    def __init__(self, app):
        super().__init__(application=app)
        self.set_title("Rising IA")
        self.set_default_size(680, 540)
        self.set_resizable(False)

        self._live_session = is_live_session()
        self._install_thread = None
        self._cancelled = False

        self._build_ui()
        self._apply_css()

    def _apply_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _build_ui(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(32)
        box.set_margin_bottom(24)
        box.set_margin_start(40)
        box.set_margin_end(40)
        self.set_content(box)

        # Título
        title = Gtk.Label(label="Rising IA")
        title.add_css_class("title-label")
        title.set_halign(Gtk.Align.START)
        box.append(title)

        subtitle = Gtk.Label(label="Instalador de stack de Inteligencia Artificial local")
        subtitle.add_css_class("subtitle-label")
        subtitle.set_halign(Gtk.Align.START)
        subtitle.set_margin_top(4)
        subtitle.set_margin_bottom(20)
        box.append(subtitle)

        # Aviso de sesión live (item 9)
        if self._live_session:
            warning = Gtk.Label()
            warning.set_markup(
                "⚠️  <b>Estás en la sesión live.</b>\n"
                "Instalá RisingOS en disco primero antes de instalar el stack de IA.\n"
                "La instalación requiere almacenamiento persistente."
            )
            warning.add_css_class("live-warning")
            warning.set_wrap(True)
            warning.set_halign(Gtk.Align.FILL)
            warning.set_margin_bottom(16)
            box.append(warning)

        # Pasos
        steps_frame = Gtk.Frame()
        steps_frame.set_label("  Componentes a instalar  ")
        steps_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        steps_box.set_margin_top(12)
        steps_box.set_margin_bottom(12)
        steps_box.set_margin_start(16)
        steps_box.set_margin_end(16)

        self._step_labels = {}
        steps = [
            ("docker",   "Docker Engine"),
            ("ollama",   "Ollama (servidor de modelos)"),
            ("qwen",     "Modelo Qwen2.5 7B (≈4.7 GB)"),
            ("webui",    "Open WebUI (interfaz web)"),
            ("desktop",  "Acceso directo en aplicaciones"),
        ]
        for key, label in steps:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            icon = Gtk.Label(label="○")
            icon.set_size_request(20, -1)
            lbl = Gtk.Label(label=label)
            lbl.add_css_class("step-label")
            lbl.set_halign(Gtk.Align.START)
            row.append(icon)
            row.append(lbl)
            steps_box.append(row)
            self._step_labels[key] = icon

        steps_frame.set_child(steps_box)
        box.append(steps_frame)

        # Barra de progreso
        self._progress = Gtk.ProgressBar()
        self._progress.set_margin_top(16)
        self._progress.set_margin_bottom(8)
        box.append(self._progress)

        self._status_label = Gtk.Label(label="Listo para instalar")
        self._status_label.add_css_class("subtitle-label")
        self._status_label.set_halign(Gtk.Align.START)
        self._status_label.set_margin_bottom(12)
        box.append(self._status_label)

        # Log
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(120)
        scroll.set_vexpand(True)
        self._log_buffer = Gtk.TextBuffer()
        self._log_view = Gtk.TextView(buffer=self._log_buffer)
        self._log_view.add_css_class("log-view")
        self._log_view.set_editable(False)
        self._log_view.set_cursor_visible(False)
        self._log_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        scroll.set_child(self._log_view)
        box.append(scroll)

        # Botón
        self._install_btn = Gtk.Button(label="Instalar Stack de IA")
        self._install_btn.add_css_class("accent-button")
        self._install_btn.set_margin_top(20)
        self._install_btn.set_halign(Gtk.Align.CENTER)
        self._install_btn.connect("clicked", self._on_install_clicked)

        # Deshabilitar en sesión live (item 9)
        if self._live_session:
            self._install_btn.set_sensitive(False)
            self._install_btn.set_tooltip_text(
                "Instalá RisingOS en disco antes de usar Rising IA"
            )

        box.append(self._install_btn)

    # ── Helpers de UI (thread-safe) ──────────────────────────────────────────
    def _log(self, msg: str):
        def _append():
            end = self._log_buffer.get_end_iter()
            self._log_buffer.insert(end, msg + "\n")
            # Auto-scroll
            adj = self._log_view.get_vadjustment()
            adj.set_value(adj.get_upper())
        GLib.idle_add(_append)

    def _set_status(self, msg: str):
        GLib.idle_add(lambda: self._status_label.set_text(msg))

    def _set_progress(self, fraction: float):
        GLib.idle_add(lambda: self._progress.set_fraction(fraction))

    def _set_step(self, key: str, status: str):
        """status: ○ ⏳ ✓ ✗"""
        GLib.idle_add(lambda: self._step_labels[key].set_text(status))

    def _set_btn_sensitive(self, val: bool):
        GLib.idle_add(lambda: self._install_btn.set_sensitive(val))

    # ── Instalación ──────────────────────────────────────────────────────────
    def _on_install_clicked(self, _btn):
        self._install_btn.set_sensitive(False)
        self._cancelled = False
        self._install_thread = threading.Thread(
            target=self._install_all, daemon=True
        )
        self._install_thread.start()

    def _run(self, cmd, timeout=300, env=None):
        """Ejecuta un comando y devuelve (returncode, stdout+stderr)."""
        result = subprocess.run(
            cmd, shell=isinstance(cmd, str),
            capture_output=True, text=True,
            timeout=timeout, env=env
        )
        return result.returncode, result.stdout + result.stderr

    def _install_all(self):
        steps = [
            ("docker",  0.0,  0.20, self._install_docker),
            ("ollama",  0.20, 0.40, self._install_ollama),
            ("qwen",    0.40, 0.65, self._pull_qwen),
            ("webui",   0.65, 0.90, self._install_openwebui),
            ("desktop", 0.90, 1.00, self._create_desktop),
        ]

        for key, p_start, p_end, fn in steps:
            self._set_step(key, "⏳")
            self._set_progress(p_start)
            ok, msg = fn()
            if ok:
                self._set_step(key, "✓")
                self._set_progress(p_end)
            else:
                self._set_step(key, "✗")
                self._set_status(f"Error en {key}: {msg}")
                self._log(f"[ERROR] {key}: {msg}")
                self._set_btn_sensitive(True)
                return

        self._set_status("✓ Instalación completada — Open WebUI en http://localhost:3000")
        self._set_progress(1.0)
        self._set_btn_sensitive(False)
        self._log("[OK] Stack de IA instalado correctamente")
        self._show_success_dialog()

    def _install_docker(self):
        self._set_status("Instalando Docker...")
        self._log("[docker] Verificando instalación...")

        rc, out = self._run("docker --version")
        if rc == 0:
            self._log(f"[docker] Ya instalado: {out.strip()}")
            return True, ""

        self._log("[docker] Instalando via apt...")
        cmds = [
            "apt-get update -qq",
            "apt-get install -y --no-install-recommends docker.io docker-compose",
            "systemctl enable docker --now",
        ]
        for cmd in cmds:
            self._log(f"[docker] $ {cmd}")
            rc, out = self._run(f"sudo {cmd}", timeout=180)
            if rc != 0:
                return False, out[:300]
            self._log(out[-200:] if out else "")

        # Agregar usuario al grupo docker
        user = os.environ.get("USER", os.environ.get("LOGNAME", ""))
        if user:
            self._run(f"sudo usermod -aG docker {user}")
            self._log(f"[docker] {user} agregado al grupo docker")

        return True, ""

    def _install_ollama(self):
        self._set_status("Instalando Ollama...")
        self._log("[ollama] Verificando instalación...")

        rc, out = self._run("ollama --version")
        if rc == 0:
            self._log(f"[ollama] Ya instalado: {out.strip()}")
            # Asegurar que el servicio esté activo
            self._run("sudo systemctl enable ollama --now")
            return True, ""

        self._log("[ollama] Descargando instalador...")
        rc, out = self._run(
            f"curl -fsSL {OLLAMA_URL} | sudo sh",
            timeout=300
        )
        if rc != 0:
            return False, out[:300]

        self._run("sudo systemctl enable ollama --now")
        self._log("[ollama] Servicio iniciado")
        return True, ""

    def _pull_qwen(self):
        self._set_status("Descargando modelo Qwen2.5 7B (≈4.7 GB)...")
        self._log("[qwen] Iniciando descarga del modelo...")
        self._log("[qwen] Esto puede tardar varios minutos según tu conexión")

        # Ollama pull con streaming para mostrar progreso
        try:
            proc = subprocess.Popen(
                ["ollama", "pull", "qwen2.5:7b"],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            for line in proc.stdout:
                line = line.rstrip()
                if line:
                    self._log(f"[qwen] {line}")
            proc.wait(timeout=3600)
            if proc.returncode != 0:
                return False, "Error al descargar Qwen2.5"
        except subprocess.TimeoutExpired:
            proc.kill()
            return False, "Timeout al descargar el modelo (>60 min)"
        except FileNotFoundError:
            return False, "ollama no encontrado — reiniciá e intentá de nuevo"

        self._log("[qwen] Modelo descargado correctamente")
        return True, ""

    def _install_openwebui(self):
        """
        Fix item 8: Docker pull colgado.
        Estrategia:
         1. Intentar pull con timeout explícito de 10 min por imagen
         2. Si falla, intentar imagen fallback
         3. Mostrar progreso línea a línea para detectar el cuelgue
        """
        self._set_status("Instalando Open WebUI...")
        self._log("[webui] Verificando si el contenedor ya existe...")

        # Si ya existe el contenedor, solo arrancarlo
        rc, out = self._run("sudo docker ps -a --filter name=open-webui --format '{{.Names}}'")
        if "open-webui" in out:
            self._log("[webui] Contenedor existente encontrado, reiniciando...")
            rc, out = self._run("sudo docker start open-webui", timeout=30)
            if rc == 0:
                return True, ""

        # Pull con timeout y fallback (fix item 8)
        images_to_try = [OPENWEBUI_IMAGE, OPENWEBUI_IMAGE_FALLBACK]
        pulled_image = None

        for image in images_to_try:
            self._log(f"[webui] Intentando pull de: {image}")
            self._log("[webui] (timeout: 10 minutos por imagen)")
            ok = self._docker_pull_with_timeout(image, timeout_seconds=600)
            if ok:
                pulled_image = image
                break
            else:
                self._log(f"[webui] Pull fallido para {image}, intentando alternativa...")

        if not pulled_image:
            return False, (
                "No se pudo descargar Open WebUI.\n"
                "Verificá tu conexión a internet e intentá de nuevo.\n"
                "También podés instalar manualmente con:\n"
                f"  sudo docker pull {OPENWEBUI_IMAGE}"
            )

        # Crear y arrancar el contenedor
        self._log(f"[webui] Creando contenedor con imagen: {pulled_image}")
        cmd = (
            f"sudo docker run -d "
            f"--name open-webui "
            f"--restart always "
            f"-p {WEBUI_PORT}:{WEBUI_PORT} "
            f"-v open-webui:/app/backend/data "
            f"-e OLLAMA_BASE_URL=http://host.docker.internal:11434 "
            f"--add-host=host.docker.internal:host-gateway "
            f"{pulled_image}"
        )
        rc, out = self._run(cmd, timeout=60)
        if rc != 0:
            return False, out[:300]

        self._log(f"[webui] Contenedor iniciado → http://localhost:{WEBUI_PORT}")
        return True, ""

    def _docker_pull_with_timeout(self, image: str, timeout_seconds: int = 600) -> bool:
        """
        Pull de Docker mostrando progreso línea a línea.
        Retorna True si el pull fue exitoso antes del timeout.
        Fix item 8: antes el proceso quedaba colgado sin feedback.
        """
        try:
            proc = subprocess.Popen(
                ["sudo", "docker", "pull", image],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )

            import select
            import time
            start = time.time()
            last_output = time.time()
            STALL_TIMEOUT = 120  # Si no hay output en 2 min, se considera cuelgue

            while True:
                elapsed = time.time() - start
                stalled = time.time() - last_output

                # Timeout total
                if elapsed > timeout_seconds:
                    proc.kill()
                    self._log(f"[webui] Timeout total ({timeout_seconds}s) para {image}")
                    return False

                # Timeout por inactividad (fix principal del cuelgue)
                if stalled > STALL_TIMEOUT:
                    proc.kill()
                    self._log(f"[webui] Sin actividad por {STALL_TIMEOUT}s — posible cuelgue de capa, abortando")
                    return False

                # Leer línea con timeout corto
                ready, _, _ = select.select([proc.stdout], [], [], 5.0)
                if ready:
                    line = proc.stdout.readline()
                    if not line:
                        break
                    line = line.rstrip()
                    if line:
                        self._log(f"[webui] {line}")
                        last_output = time.time()
                else:
                    # No hay output, seguir esperando (actualizamos status)
                    self._log(f"[webui] Esperando... ({int(elapsed)}s / {timeout_seconds}s)")

                if proc.poll() is not None:
                    break

            proc.wait(timeout=10)
            return proc.returncode == 0

        except Exception as e:
            self._log(f"[webui] Error en pull: {e}")
            return False

    def _create_desktop(self):
        """Crea el .desktop de Open WebUI (item 10)."""
        self._set_status("Creando acceso directo...")
        try:
            create_openwebui_desktop()
            self._log(f"[desktop] .desktop creado en: {DESKTOP_FILE}")
            return True, ""
        except Exception as e:
            return False, str(e)

    def _show_success_dialog(self):
        def _show():
            dialog = Adw.MessageDialog(
                transient_for=self,
                heading="✓ Instalación completada",
                body=(
                    f"Open WebUI está disponible en:\n"
                    f"http://localhost:{WEBUI_PORT}\n\n"
                    f"Se creó un acceso directo en tus aplicaciones.\n"
                    f"Nota: puede tardar unos segundos en iniciar la primera vez."
                )
            )
            dialog.add_response("ok", "Abrir en navegador")
            dialog.add_response("close", "Cerrar")
            dialog.set_default_response("ok")
            dialog.connect("response", self._on_success_response)
            dialog.present()
        GLib.idle_add(_show)

    def _on_success_response(self, dialog, response):
        if response == "ok":
            Gio.AppInfo.launch_default_for_uri(
                f"http://localhost:{WEBUI_PORT}", None
            )
        dialog.close()


# ── App ────────────────────────────────────────────────────────────────────────
class RisingIAApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )

    def do_activate(self):
        win = RisingIAWindow(self)
        win.present()


if __name__ == "__main__":
    app = RisingIAApp()
    sys.exit(app.run(sys.argv))

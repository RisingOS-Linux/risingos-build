msgid "5.2 GB — recomendado con 16 GB+ de RAM"
msgstr "5.2 GB — recommended with 16 GB+ of RAM"

msgid "1.9 GB — recomendado con menos de 16 GB de RAM"
msgstr "1.9 GB — recommended with less than 16 GB of RAM"

msgid "Instalar driver NVIDIA propietario"
msgstr "Install proprietary NVIDIA driver"

msgid "Instalar Ollama"
msgstr "Install Ollama"

msgid "Activar servicio Ollama"
msgstr "Enable Ollama service"

msgid "Configurar Ollama (escucha en red)"
msgstr "Configure Ollama (listen on network)"

msgid "Instalar Docker"
msgstr "Install Docker"

msgid "Activar servicio Docker"
msgstr "Enable Docker service"

#, python-brace-format
msgid "Descargar modelo {model}"
msgstr "Download model {model}"

msgid "Lanzar Open WebUI"
msgstr "Launch Open WebUI"

msgid "Crear acceso directo Open WebUI"
msgstr "Create Open WebUI shortcut"

msgid "Conectado a internet"
msgstr "Connected to the internet"

msgid "Sin conexión — la instalación requiere internet"
msgstr "No connection — installation requires internet"

msgid "REQUISITOS MÍNIMOS"
msgstr "MINIMUM REQUIREMENTS"

msgid "CPU    4 núcleos"
msgstr "CPU    4 cores"

msgid "RAM    8 GB"
msgstr "RAM    8 GB"

msgid "Disco  10 GB libres"
msgstr "Disk   10 GB free"

msgid "GPU    No necesaria"
msgstr "GPU    Not required"

